# Telegram Bot Token obtained from @BotFather (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram API credentials from https://my.telegram.org (Required to use MTProto and bypass the 20 MB limit)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Bot Owner's Telegram User ID (Exempt from the 3 runs per day limit. Use @userinfobot to get your ID)
OWNER_ID=your_telegram_user_id_here

# AnyKernel repository to clone and modify (Optional, defaults to osm0sis/AnyKernel3)
ANYKERNEL_REPO=https://github.com/osm0sis/AnyKernel3.git

# AnyKernel repository branch to clone (Optional, defaults to master)
ANYKERNEL_BRANCH=master

# gofile.io account token (Optional). If empty, a temporary anonymous account is created per download.
GF_TOKEN=

# gofile.io connect timeout in seconds (Optional, defaults to 15.0)
GF_TIMEOUT=15.0

# Override the gofile.io website-token salt when the dynamic extraction fails (Optional)
GOFILE_WT_SALT=

# Directory used for sessions, downloads, magiskboot and usage.json (Optional, defaults to the current directory)
WORKSPACE_DIR=./workspace

# Telegram session database (Optional, defaults to $WORKSPACE_DIR/repacker_bot.session)
# SESSION_PATH=./workspace/repacker_bot.session

# Cached magiskboot binary (Optional, defaults to $WORKSPACE_DIR/magiskboot)
# MAGISKBOOT_PATH=./workspace/magiskboot

# Number of boot images processed in parallel (Optional, defaults to 4)
MAX_CONCURRENT_JOBS=4

# Log verbosity (trace, debug, info, warn, error)
RUST_LOG=info
